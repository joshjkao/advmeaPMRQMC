CXX      ?= g++
MPICXX   ?= mpicxx
CXXFLAGS ?= -O3 -std=c++23 -MMD -MP

# ------------------------------------------------------------------------------
# Hamiltonian Input Configuration
# ------------------------------------------------------------------------------
H_FIXED ?= H.txt
# Auto-detects H_gamma.txt if present, or can be set via CLI: make H_GAMMA=H_gamma.txt
H_GAMMA ?= $(wildcard H_gamma.txt)

# Dynamically construct prerequisites and generator flags
PREPARE_DEPS := $(H_FIXED) $(H_GAMMA)

ifeq ($(strip $(H_GAMMA)),)
  PREPARE_ARGS := $(H_FIXED)
else
  PREPARE_ARGS := --hamiltonian-fixed $(H_FIXED) --hamiltonian-gamma $(H_GAMMA)
endif

# ------------------------------------------------------------------------------
# Targets & Targets Definition
# ------------------------------------------------------------------------------
TARGETS := prepare.bin PMRQMC.bin PMRQMC_mpi.bin PMRQMC_pt_mpi.bin PMRQMC_qcpt_mpi.bin

.PHONY: all clean test validate-pt

all: $(TARGETS)

# Include header dependency rules (.d files) generated by g++
-include $(wildcard *.d) $(wildcard tests/*.d)

# ------------------------------------------------------------------------------
# 1. Code Generator & Dynamic Header Rule
# ------------------------------------------------------------------------------
prepare.o: prepare.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

prepare.bin: prepare.o
	$(CXX) $(CXXFLAGS) -o $@ $<

hamiltonian.hpp: prepare.bin $(PREPARE_DEPS)
	@if [ -f hamiltonian.hpp ]; then mv hamiltonian.hpp hamiltonian.hpp.old; fi
	@if ./prepare.bin $(PREPARE_ARGS); then \
		if cmp -s hamiltonian.hpp.old hamiltonian.hpp 2>/dev/null; then \
			echo "hamiltonian.hpp content unchanged."; \
			mv hamiltonian.hpp.old hamiltonian.hpp; \
		else \
			echo "Updating hamiltonian.hpp ($(PREPARE_ARGS))..."; \
			rm -f hamiltonian.hpp.old; \
		fi; \
	else \
		echo "Error: prepare.bin execution failed." >&2; \
		if [ -f hamiltonian.hpp.old ]; then mv hamiltonian.hpp.old hamiltonian.hpp; fi; \
		exit 1; \
	fi
# ------------------------------------------------------------------------------
# 2. Compilation Rules
# ------------------------------------------------------------------------------
# Target-specific macro flag for QCPT binary
PMRQMC_qcpt_mpi.o: CPPFLAGS += -DPMR_QCPT

# Order-only dependency (| hamiltonian.hpp) ensures header exists before compiling
%.o: %.cpp | hamiltonian.hpp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c -o $@ $<

%_mpi.o: %_mpi.cpp | hamiltonian.hpp
	$(MPICXX) $(CXXFLAGS) $(CPPFLAGS) -c -o $@ $<

# ------------------------------------------------------------------------------
# 3. Executable Linking
# ------------------------------------------------------------------------------
PMRQMC.bin: PMRQMC.o
	$(CXX) $(CXXFLAGS) -o $@ $<

PMRQMC_mpi.bin: PMRQMC_mpi.o
	$(MPICXX) $(CXXFLAGS) -o $@ $<

PMRQMC_pt_mpi.bin: PMRQMC_pt_mpi.o
	$(MPICXX) $(CXXFLAGS) -o $@ $<

PMRQMC_qcpt_mpi.bin: PMRQMC_qcpt_mpi.o
	$(MPICXX) $(CXXFLAGS) -o $@ $<

# ------------------------------------------------------------------------------
# 4. Testing & Validation
# ------------------------------------------------------------------------------
tests/pt_components_test: tests/pt_components_test.o
	$(CXX) $(CXXFLAGS) -o $@ $<

test: tests/pt_components_test
	./tests/pt_components_test /tmp/pmrqmc_pt_schedule_test.txt
	python3 tests/pt_python_test.py

validate-pt:
	python3 experiments/validate_pt_minimal.py --oversubscribe

# ------------------------------------------------------------------------------
# Clean
# ------------------------------------------------------------------------------
clean:
	rm -f *.o *.d tests/*.o tests/*.d *.tmp $(TARGETS) tests/pt_components_test hamiltonian.hpp
